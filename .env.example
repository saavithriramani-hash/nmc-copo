# CO–PO Attainment — production configuration.
# Copy this file to .env and change POSTGRES_PASSWORD before deploying.
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────
# The database password. Change it. It is never shown to users, so make it
# long and random; nobody needs to type it.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Usually left alone ──────────────────────────────────────────────────
POSTGRES_USER=copo
POSTGRES_DB=copo

# The port staff will use in their browser: http://<server>:3000
APP_PORT=3000

# Where nightly backups are written on THIS machine.
BACKUP_DIR=./backups

# ── The second copy on campus (strongly recommended) ────────────────────
# A backup on the same machine does not survive that machine failing.
# Mount a share from another building here, e.g. /mnt/library-nas/copo.
# Leave BACKUP_SECONDARY_DIR empty to disable (the health page will warn).
BACKUP_SECONDARY_MOUNT=./backups-secondary
BACKUP_SECONDARY_DIR=/backups-secondary

# ── Backup schedule and retention ───────────────────────────────────────
# Time of night to run the backup, 24-hour clock, server local time.
BACKUP_AT=02:00

# Retention. Every night's dump is kept for KEEP_DAILY_DAYS; the Sunday
# dump is kept for KEEP_WEEKLY_DAYS; the 1st-of-month dump is kept for
# KEEP_MONTHLY_DAYS. The defaults keep monthly dumps for six years, which
# covers a five-year accreditation cycle with room to spare.
KEEP_DAILY_DAYS=35
KEEP_WEEKLY_DAYS=400
KEEP_MONTHLY_DAYS=2200

# How often to prove a backup can actually be restored, in days.
VERIFY_EVERY_DAYS=7

# ── Set automatically by ops/upgrade.sh; leave alone ────────────────────
APP_VERSION=latest
