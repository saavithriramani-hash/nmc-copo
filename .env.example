# CO–PO Attainment — production configuration.
# Copy this file to .env and change POSTGRES_PASSWORD before deploying.
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────
# The database password. Change it. It is never shown to users, so make it
# long and random; nobody needs to type it.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Usually left alone ──────────────────────────────────────────────────
POSTGRES_USER=copo
POSTGRES_DB=copo

# The port staff will use in their browser: http://<server>:3000
APP_PORT=3000

# The server's own timezone. BACKUP_AT below is read in this zone, so
# getting it wrong moves the nightly backup into the working day.
TZ=Asia/Kolkata

# ── HTTPS ───────────────────────────────────────────────────────────────
# Is the system reached over https:// ?
#
#   false  plain http:// on the campus network  (the default below)
#   true   behind TLS — a reverse proxy with a certificate
#
# This controls whether the sign-in cookie is marked "Secure". A Secure
# cookie is only accepted over HTTPS, so leaving this true on an http://
# deployment lets people sign in and then bounces them straight back to
# the login screen — except on the server's own console, because browsers
# treat localhost as trustworthy. That is why it must be said explicitly.
#
# WHILE THIS IS false THE SIGN-IN COOKIE TRAVELS IN CLEAR over the campus
# network, and so does every password typed into the login page. It is a
# stopgap. Put TLS in front and set this to true before the whole college
# depends on the system.
COPO_COOKIE_SECURE=false

# Where nightly backups are written on THIS machine.
BACKUP_DIR=./backups

# ── The second copy on campus (strongly recommended) ────────────────────
# A backup on the same machine does not survive that machine failing.
# Mount a share from another building here, e.g. /mnt/library-nas/copo.
# Leave BACKUP_SECONDARY_DIR empty to disable (the health page will warn).
BACKUP_SECONDARY_MOUNT=./backups-secondary
BACKUP_SECONDARY_DIR=/backups-secondary

# ── Backup schedule and retention ───────────────────────────────────────
# Time of night to run the backup, 24-hour clock, server local time.
BACKUP_AT=02:00

# Retention. Every night's dump is kept for KEEP_DAILY_DAYS; the Sunday
# dump is kept for KEEP_WEEKLY_DAYS; the 1st-of-month dump is kept for
# KEEP_MONTHLY_DAYS. The defaults keep monthly dumps for six years, which
# covers a five-year accreditation cycle with room to spare.
KEEP_DAILY_DAYS=35
KEEP_WEEKLY_DAYS=400
KEEP_MONTHLY_DAYS=2200

# How often to prove a backup can actually be restored, in days.
VERIFY_EVERY_DAYS=7

# ── Nightly housekeeping (ops/cleanup.sh, runs after each backup) ────────
# Only derived, reproducible or expired things are removed. Marks,
# attainment snapshots and the AUDIT LOG are never touched — the audit
# log deliberately has no setting here, because it is the record of who
# changed what (NFR-9) and costs only a few hundred MB over five years.

# Working directories left behind by finished accreditation bundles.
# The bundle .zip itself is the deliverable and is never auto-deleted.
KEEP_BUNDLE_WORKDIR_DAYS=30

# Completed and failed background jobs. A consolidation older than this
# is simply re-run — every figure is recomputed from the marks.
KEEP_JOB_DAYS=180

# Session rows that can no longer sign anyone in (revoked, or past their
# absolute expiry). The login history itself lives in the audit log.
KEEP_EXPIRED_SESSION_DAYS=90

# ── Set automatically by ops/deploy.sh; leave alone ─────────────────────
# Authorises creating the FIRST administrator, and nothing else. The
# bootstrap route refuses every call once an administrator exists, so
# this token is spent the moment deployment finishes.
# BOOTSTRAP_TOKEN=

# ── Set automatically by ops/upgrade.sh ─────────────────────────────────
# Which version of the application to run. With docker-compose.prod.yml —
# the stack that downloads the application instead of compiling it — this
# also decides WHICH published image is pulled. Left at `latest` the
# server takes whatever was published most recently the next time it
# restarts; naming a version (APP_VERSION=v1.0.0) makes upgrading a
# decision instead of a surprise.
APP_VERSION=latest

# Where to pull the application from, for docker-compose.prod.yml only.
# Change it if this project is forked and published elsewhere.
# COPO_IMAGE=ghcr.io/saavithriramani-hash/nmc-copo
